# Kept ONLY to surface the on-box (same LightOS device) option in the pairing
# UI. The default pairing command uses the app's public HTTPS origin (injected
# at runtime as window.__CUMORA_PUBLIC_ORIGIN, or window.location.origin), which
# a BYOA daemon on a device logged into the Lazycat client can reach. The
# `.lzcapp` address below is app-to-app only and is never the default.
VITE_CUMORA_COMPUTER_SERVER=http://cumora.cloud.lazycat.app.cumora.lzcapp:5181
